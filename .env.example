# Zkopíruj jako .env a doplň vlastní hesla:  cp .env.example .env
# Silné heslo vygeneruješ příkazem:  openssl rand -hex 12
# Soubor .env se NIKDY necommituje (je v .gitignore).

# Doména pro HTTPS (např. lukas-iot.duckdns.org) – musí ukazovat na IP serveru
DOMAIN=

POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
